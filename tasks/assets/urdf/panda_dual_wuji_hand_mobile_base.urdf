<?xml version="1.0"?>
<!--
  Combined URDF: PartNet-Mobility 22870 base + 2 upright Franka Panda arms
  + 2 Wuji hands (with docking adapters).
  See tasks/assets/wuji_hand_meshes/README.md for docking adapter details.
-->
